# TMF LogicalOperators SHACL Shapes
#
# Domain-specific validation for LogicalOperators.
# Global validation (function usage, vocabulary) handled by lib/GlobalShapes.ttl
#
# Ontology URI: http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/

@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# TMF namespaces
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix imo: <http://tio.models.tmforum.org/tio/v3.6.0/IntentManagementOntology/> .

# Shape namespaces  
@prefix log-shapes: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/LogicalOperators/> .
@prefix tio-lib: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/lib/> .
@prefix tio-targets: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/lib/targets/> .
@prefix tio-constraints: <http://tio.models.tmforum.org/tio/v3.6.0/shapes/lib/constraints/> .

# =============================================================================
# LOGICAL FUNCTION RESULT TYPE VALIDATION
# =============================================================================

# Validates logical operator functions return boolean
log-shapes:LogicalFunctionResultTypeShape
    a sh:NodeShape ;
    rdfs:label "Logical Function Result Type Validation" ;
    rdfs:comment "Validates logical operator functions have xsd:boolean as resultType." ;
    sh:target [
        a tio-targets:OntologyClassTargetType ;
        tio-lib:ontologyNamespace "http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/" ;
        tio-lib:targetClass fun:Function ;
    ] ;
    
    sh:sparql tio-constraints:FunctionBooleanResultTypeConstraint ;
    sh:severity sh:Violation .

# =============================================================================
# NOTES
# =============================================================================
# Universal validation (applies to all ontologies):
# - Vocabulary: tio-lib:VocabularyUsageShape
# - Function usage: tio-lib:FunctionUsageShape
