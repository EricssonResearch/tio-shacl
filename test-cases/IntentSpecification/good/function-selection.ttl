# Test: Valid usage of Selection functions
# Concepts covered: chosenAll, chosenAllFor, chosenAny, chosenAnyFor, selectValues,
#                   usedVocabularyFor, valueSelected, valueSelectedFor
# This test validates that selection functions can be used correctly.

@prefix ex: <http://example.org/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix isp: <http://tio.models.tmforum.org/tio/v3.6.0/IntentSpecification/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# === chosenAll function: (ContentTemplate) ===
ex:test_chosenall
  a rdfs:Resource ;
  isp:chosenAll ( ex:content_template1 ) .

# === chosenAllFor function: (rdfs:Resource, ContentTemplate...) ===
ex:test_chosenallfor
  a rdfs:Resource ;
  isp:chosenAllFor ( ex:intent_element ex:content_template1 ) .

# === chosenAny function: (ContentTemplate) ===
ex:test_chosenany
  a rdfs:Resource ;
  isp:chosenAny ( ex:content_template1 ) .

# === chosenAnyFor function: (rdfs:Resource, ContentTemplate...) ===
ex:test_chosenanyfor
  a rdfs:Resource ;
  isp:chosenAnyFor ( ex:intent_element ex:content_template1 ) .

# === selectValues function: (rdfs:Resource, log:Condition...) ===
ex:test_selectvalues
  a rdfs:Resource ;
  isp:selectValues ( ex:variable1 ex:condition1 ) .

# === usedVocabularyFor function: (rdfs:Resource, rdfs:Container...) ===
ex:test_usedvocabularyfor
  a rdfs:Resource ;
  isp:usedVocabularyFor ( ex:intent_element ex:vocab_container ) .

# === valueSelected function: (ObjectTemplate, ContentTemplate...) ===
ex:test_valueselected
  a rdfs:Resource ;
  isp:valueSelected ( ex:object_template1 ex:content_template1 ) .

# === valueSelectedFor function: (rdfs:Resource, ObjectTemplate, ContentTemplate...) ===
ex:test_valueselectedfor
  a rdfs:Resource ;
  isp:valueSelectedFor ( ex:intent_element ex:object_template1 ex:content_template1 ) .

# Supporting instances with correct types
ex:intent_element a rdfs:Resource .
ex:variable1 a rdfs:Resource .
ex:content_template1 a isp:ContentTemplate .
ex:object_template1 a isp:ObjectTemplate .
ex:condition1 a log:Condition ; log:allOf ( "true"^^xsd:boolean ) .
ex:vocab_container a rdfs:Container .
