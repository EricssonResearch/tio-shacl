# Test: Valid usage of Specification properties
# Concepts covered: allowedValues, alternative, applicableIf, applicableIfNot,
#                   availableVocabulary, chosenHandlingDomain, chosenIntentHandler,
#                   content, contentUsing, intentHandlerVendor, intentOwner,
#                   intentOwnerDomain, intentOwnerVendor, mandatory, mandatoryIntent,
#                   mandatorySpecification, option, optionalIntent, optionalSpecification,
#                   templateType
# This test validates that specification properties can be used correctly.

@prefix ex: <http://example.org/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix isp: <http://tio.models.tmforum.org/tio/v3.6.0/IntentSpecification/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# === Core template properties ===
ex:test_allowedvalues a isp:ObjectTemplate ; isp:allowedValues ( ex:val1 ) .
ex:test_alternative a isp:Template ; isp:alternative ex:alt1 .
ex:test_applicableif a isp:ContentTemplate ; isp:applicableIf ex:cond1 .
ex:test_applicableifnot a isp:ContentTemplate ; isp:applicableIfNot ex:cond2 .
ex:test_availablevocabulary a isp:Template ; isp:availableVocabulary ( ex:vocab1 ) .
ex:test_chosenhandlingdomain
  a rdfs:Resource ;
  isp:chosenHandlingDomain ex:domain1 .
ex:test_chosenintenthandler
  a rdfs:Resource ;
  isp:chosenIntentHandler ex:handler1 .
ex:test_templatetype a isp:ObjectTemplate ; isp:templateType ex:type1 .
ex:test_option a isp:Template ; isp:option ex:option_value .

# === Content properties ===
ex:test_content a isp:ContentTemplate ; isp:content ex:content_value .
ex:test_contentusing a isp:ContentTemplate ; isp:contentUsing ex:vocab_template .

# === Owner and vendor properties ===
ex:test_intentowner
  a rdfs:Resource ;
  isp:intentOwner ex:owner1 .
ex:test_intentownerdomain
  a rdfs:Resource ;
  isp:intentOwnerDomain ex:domain2 .
ex:test_intentownervendor
  a rdfs:Resource ;
  isp:intentOwnerVendor ex:vendor1 .
ex:test_intenthandlervendor
  a rdfs:Resource ;
  isp:intentHandlerVendor ex:vendor2 .

# === Mandatory/optional properties ===
ex:test_mandatory
  a rdfs:Resource ;
  isp:mandatory ex:mandatory_value .
ex:test_mandatoryintent a isp:IntentSpecification ; isp:mandatoryIntent ex:intent1 .
ex:test_mandatoryspecification a isp:IntentSpecification ; isp:mandatorySpecification ex:spec1 .
ex:test_optionalintent a isp:IntentSpecification ; isp:optionalIntent ex:intent2 .
ex:test_optionalspecification a isp:IntentSpecification ; isp:optionalSpecification ex:spec2 .

# === Supporting instances ===
ex:val1 a rdfs:Resource .
ex:alt1 a isp:Template .
ex:cond1 a rdfs:Resource .
ex:cond2 a rdfs:Resource .
ex:vocab1 a rdfs:Resource .
ex:domain1 a rdfs:Resource .
ex:handler1 a rdfs:Resource .
ex:content_value a rdfs:Resource .
ex:vocab_template a isp:VocabularyTemplate .
ex:owner1 a rdfs:Resource .
ex:domain2 a rdfs:Resource .
ex:vendor1 a rdfs:Resource .
ex:vendor2 a rdfs:Resource .
ex:mandatory_value a rdfs:Resource .
ex:intent1 a icm:Intent ; log:allOf ( "true"^^xsd:boolean ) .
ex:intent2 a icm:Intent ; log:allOf ( "true"^^xsd:boolean ) .
ex:spec1 a isp:IntentSpecification .
ex:spec2 a isp:IntentSpecification .
ex:option_value a rdfs:Resource .
ex:type1 a rdfs:Resource .
