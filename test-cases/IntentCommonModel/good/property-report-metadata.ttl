# Test: Valid usage of Report metadata properties
# Concepts covered: reportDestination, reportDestinations, reportGenerated, reportNumber, reportTriggers
# This test validates that report-related properties can be used correctly.

@prefix ex: <http://example.org/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix t: <http://www.w3.org/2006/time#> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Intent referencing the expectation to avoid unreferenced warning
ex:test_intent a icm:Intent ;
  log:allOf ( ex:sample_reporting_expectation ) .

# Sample reporting expectation for property tests
# reportDestinations and reportTriggers must be rdfs:Container
# reportGenerated and reportNumber have domain IntentReport (not ReportingExpectation)
ex:sample_reporting_expectation
  a icm:ReportingExpectation ;
  icm:target ex:sample_target ;
  icm:reportDestination ex:destination1 ;
  icm:reportDestinations ex:dest_container ;
  icm:reportTriggers ex:trigger_container .

# IntentReport for report metadata properties (domain = IntentReport)
ex:sample_report
  a icm:IntentReport ;
  icm:reportGenerated ex:report_timestamp ;
  icm:reportNumber "1"^^xsd:positiveInteger .

# Proper time:Instant for reportGenerated
ex:report_timestamp
  a t:Instant ;
  t:inXSDDateTimeStamp "2024-01-01T00:00:00Z"^^xsd:dateTimeStamp .

ex:sample_target a icm:Target .
ex:destination1 a rdfs:Resource .
ex:destination2 a rdfs:Resource .
ex:trigger1 a rdfs:Resource .

# Containers for reportDestinations and reportTriggers
ex:dest_container a rdfs:Container ;
    rdfs:member ex:destination1 ;
    rdfs:member ex:destination2 .

ex:trigger_container a rdfs:Container ;
    rdfs:member ex:trigger1 .
