# Test: ReportingExpectation missing required target
# This test validates that Expectation instances must have icm:target
# Should FAIL with: "Expectation missing required icm:target"

@prefix ex:   <http://example.org/> .
@prefix icm:  <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix imo:  <http://tio.models.tmforum.org/tio/v3.6.0/IntentManagementOntology/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

################################################################################
# VIOLATION: Expectation without target
#
# Common mistake: Creating an Expectation without specifying what it applies to
# All Expectation instances MUST have at least one icm:target property
################################################################################

# WRONG - ReportingExpectation without target
ex:RE1
  a icm:ReportingExpectation ;
  # WRONG: Missing "icm:target ex:T1 ;"
  icm:reportTriggers [
    a rdfs:Container ;
    rdfs:member imo:Complies
  ]
  .
