# Test: ValidityReportingExpectation missing target
# Inherits from ReportingExpectation which requires icm:target

@prefix ex:  <http://example.org/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix iv:  <http://tio.models.tmforum.org/tio/v3.6.0/IntentValidityOntology/> .
@prefix imo: <http://tio.models.tmforum.org/tio/v3.6.0/IntentManagementOntology/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

################################################################################
# VIOLATION: ValidityReportingExpectation missing target
################################################################################

ex:validity_reporting_no_target
  a iv:ValidityReportingExpectation ;
  log:allOf ( "true"^^xsd:boolean ) ;
  icm:reportTriggers [
    a rdfs:Container ;
    rdfs:member imo:Complies
  ] .
  # WRONG: Missing icm:target

################################################################################
# VIOLATION: ValidityReport with literal about
################################################################################

ex:validity_report_literal_about
  a iv:ValidityReport ;
  icm:about "some validity" ;  # WRONG: literal not IRI
  icm:result true .
