# Test: Valid instances of validity classes
# Concepts covered: Validity, ValidityChange, ValidityChangeInvalid, ValidityChangeValid, ValidityReport, ValidityReportingExpectation
# This test validates that valid instances of validity classes can be created.

@prefix ex: <http://example.org/> .
@prefix icm: <http://tio.models.tmforum.org/tio/v3.6.0/IntentCommonModel/> .
@prefix ivo: <http://tio.models.tmforum.org/tio/v3.6.0/IntentValidityOntology/> .
@prefix log: <http://tio.models.tmforum.org/tio/v3.6.0/LogicalOperators/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Intent referencing the expectation to avoid unreferenced warning
ex:test_intent a icm:Intent ;
  log:allOf ( ex:test_validityreportingexpectation ) .

# === Validity class ===
ex:test_validity a ivo:Validity .

# === ValidityChange class ===
ex:test_validitychange a ivo:ValidityChange .

# === ValidityChangeInvalid class ===
ex:test_validitychangeinvalid a ivo:ValidityChangeInvalid .

# === ValidityChangeValid class ===
ex:test_validitychangevalid a ivo:ValidityChangeValid .

# === ValidityReport class ===
ex:test_validityreport a ivo:ValidityReport .

# === ValidityReportingExpectation class ===
ex:test_validityreportingexpectation a ivo:ValidityReportingExpectation ;
    icm:target ex:target1 ;
    log:allOf ( "true"^^xsd:boolean ) .

# Supporting instances
ex:target1 a icm:Target .
