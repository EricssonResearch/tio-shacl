# Test: Valid usage of aggregation functions
# Concepts covered: greatest, smallest, greatestInSet, smallestInSet
# This test validates that aggregation functions can be used correctly.

@prefix ex: <http://example.org/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# === greatest function ===
ex:test_greatest
  a rdfs:Resource ;
  quan:greatest ( ex:q1 ex:q2 ) .

# === smallest function ===
ex:test_smallest
  a rdfs:Resource ;
  quan:smallest ( ex:q1 ex:q2 ) .

# === greatestInSet function ===
ex:test_greatestinset
  a rdfs:Resource ;
  quan:greatestInSet ( ex:set1 ) .

# === smallestInSet function ===
ex:test_smallestinset
  a rdfs:Resource ;
  quan:smallestInSet ( ex:set1 ) .

# Supporting quantity instances
ex:q1 a quan:Quantity ; rdf:value "100"^^xsd:decimal ; quan:unit "ms"^^xsd:string .
ex:q2 a quan:Quantity ; rdf:value "110"^^xsd:decimal ; quan:unit "ms"^^xsd:string .
ex:set1 a rdfs:Container .
