# Test: Valid usage of statistical functions
# Concepts covered: mean, median, meanOfSet, medianOfSet
# This test validates that statistical functions can be used correctly.

@prefix ex: <http://example.org/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# === mean function ===
ex:test_mean
  a rdfs:Resource ;
  quan:mean ( ex:q1 ex:q2 ) .

# === median function ===
ex:test_median
  a rdfs:Resource ;
  quan:median ( ex:q1 ex:q2 ) .

# === meanOfSet function ===
ex:test_meanofset
  a rdfs:Resource ;
  quan:meanOfSet ( ex:set1 ) .

# === medianOfSet function ===
ex:test_medianofset
  a rdfs:Resource ;
  quan:medianOfSet ( ex:set1 ) .

# Supporting quantity instances
ex:q1 a quan:Quantity ; rdf:value "100"^^xsd:decimal ; quan:unit "ms"^^xsd:string .
ex:q2 a quan:Quantity ; rdf:value "110"^^xsd:decimal ; quan:unit "ms"^^xsd:string .
ex:set1 a rdfs:Container .
