# Test: Valid usage of comparison functions
# Concepts covered: atLeast, atMost, greater, smaller, inRange, exactly
# This test validates that comparison functions can be used correctly.

@prefix ex: <http://example.org/> .
@prefix fun: <http://tio.models.tmforum.org/tio/v3.6.0/FunctionOntology/> .
@prefix quan: <http://tio.models.tmforum.org/tio/v3.6.0/QuantityOntology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# === atLeast function ===
ex:test_atleast
  a rdfs:Resource ;
  quan:atLeast ( ex:q1 ex:q2 ) .

# === atMost function ===
ex:test_atmost
  a rdfs:Resource ;
  quan:atMost ( ex:q1 ex:q2 ) .

# === greater function ===
ex:test_greater
  a rdfs:Resource ;
  quan:greater ( ex:q1 ex:q2 ) .

# === smaller function ===
ex:test_smaller
  a rdfs:Resource ;
  quan:smaller ( ex:q1 ex:q2 ) .

# === inRange function ===
ex:test_inrange
  a rdfs:Resource ;
  quan:inRange ( ex:q1 ex:q2 ex:q3 ) .

# === exactly function ===
ex:test_exactly
  a rdfs:Resource ;
  quan:exactly ( ex:q1 ex:q2 ) .

# Supporting quantity instances
ex:q1 a quan:Quantity ; rdf:value "100"^^xsd:decimal ; quan:unit "ms"^^xsd:string .
ex:q2 a quan:Quantity ; rdf:value "110"^^xsd:decimal ; quan:unit "ms"^^xsd:string .
ex:q3 a quan:Quantity ; rdf:value "120"^^xsd:decimal ; quan:unit "ms"^^xsd:string .
