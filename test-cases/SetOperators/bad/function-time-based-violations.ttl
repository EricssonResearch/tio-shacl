@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# === membersAfter violations (zero args) ===
ex:invalid_membersafter set:membersAfter ( ) .

# === membersBefore violations (zero args) ===
ex:invalid_membersbefore set:membersBefore ( ) .

# === membersSameTime violations (zero args) ===
ex:invalid_memberssametime set:membersSameTime ( ) .

# === membersWhile violations (zero args) ===
ex:invalid_memberswhile set:membersWhile ( ) .

# === newestMember violations (zero args) ===
ex:invalid_newestmember set:newestMember ( ) .

# === oldestMember violations (zero args) ===
ex:invalid_oldestmember set:oldestMember ( ) .
