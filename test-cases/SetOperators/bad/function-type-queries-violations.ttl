@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# === resourcesOfType violations (zero args) ===
ex:invalid_resourcesoftype set:resourcesOfType ( ) .

# === resourcesWithProperty violations (zero args) ===
ex:invalid_resourceswithproperty set:resourcesWithProperty ( ) .

# === resourcesWithPropertyObject violations (zero args) ===
ex:invalid_resourceswithpropertyobject set:resourcesWithPropertyObject ( ) .

# === typesOfMembers violations (zero args) ===
ex:invalid_typesofmembers set:typesOfMembers ( ) .

# === valuesOfObjectProperty violations (zero args) ===
ex:invalid_valuesofobjectproperty set:valuesOfObjectProperty ( ) .
