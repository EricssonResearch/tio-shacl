# Test: Invalid usage of set membership functions
# Concepts covered: elementOf, isMember, forAll
# Constraints tested: Arity violations
# This test validates that violations are caught for invalid set membership function usage.

@prefix ex: <http://example.org/> .
@prefix set: <http://tio.models.tmforum.org/tio/v3.6.0/SetOperators/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# === elementOf violations (zero args) ===
ex:invalid_elementof set:elementOf ( ) .

# === isMember violations (zero args) ===
ex:invalid_ismember set:isMember ( ) .

# === forAll violations (zero args) ===
ex:invalid_forall set:forAll ( ) .
