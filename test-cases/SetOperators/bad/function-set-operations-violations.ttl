# Test: Invalid usage of set operation functions
# Concepts covered: union, intersection, difference, includedIn, intersectsWith, empty
# Constraints tested: Arity violations
# This test validates that violations are caught for invalid set operation function usage.

@prefix ex: <http://example.org/> .
@prefix set: <http://tio.models.tmforum.org/tio/v3.6.0/SetOperators/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# === union violations (zero args) ===
ex:invalid_union set:union ( ) .

# === intersection violations (zero args) ===
ex:invalid_intersection set:intersection ( ) .

# === difference violations (zero args) ===
ex:invalid_difference set:difference ( ) .

# === includedIn violations (zero args) ===
ex:invalid_includedin set:includedIn ( ) .

# === intersectsWith violations (zero args) ===
ex:invalid_intersectswith set:intersectsWith ( ) .

# === empty violations (zero args) ===
ex:invalid_empty set:empty ( ) .
