# Test: Valid instances of guarantee event classes
# Concepts covered: GuaranteeAccepted, GuaranteeRejected, ConfidenceLevelNotObtainable, ConfidenceLevelNotReached, GuaranteePeriodNotObtainable, GuaranteePeriodTooLong, GuaranteePeriodUpdate, GuaranteePeriodUpdateIntervalTooLong
# This test validates that valid instances of guarantee event classes can be created.

@prefix ex: <http://example.org/> .
@prefix igo: <http://tio.models.tmforum.org/tio/v3.6.0/IntentGuaranteeOntology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# === GuaranteeAccepted class ===
ex:test_accepted a igo:GuaranteeAccepted .

# === GuaranteeRejected class ===
ex:test_rejected a igo:GuaranteeRejected .

# === ConfidenceLevelNotObtainable class ===
ex:test_conf_not_obtainable a igo:ConfidenceLevelNotObtainable .

# === ConfidenceLevelNotReached class ===
ex:test_conf_not_reached a igo:ConfidenceLevelNotReached .

# === GuaranteePeriodNotObtainable class ===
ex:test_period_not_obtainable a igo:GuaranteePeriodNotObtainable .

# === GuaranteePeriodTooLong class ===
ex:test_period_too_long a igo:GuaranteePeriodTooLong .

# === GuaranteePeriodUpdate class ===
ex:test_period_update a igo:GuaranteePeriodUpdate .

# === GuaranteePeriodUpdateIntervalTooLong class ===
ex:test_update_interval_too_long a igo:GuaranteePeriodUpdateIntervalTooLong .
